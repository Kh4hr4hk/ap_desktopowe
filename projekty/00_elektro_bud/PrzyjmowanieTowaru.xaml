<Window x:Class="ElektroBudWPF.PrzyjmowanieTowaru"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElektroBudWPF"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        
        Title="Elektro-Bud. Formularz przyjmowania towaru" Height="600" Width="1200" Background="#FB6E8686" Foreground="White" FontFamily="Verdana">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="181*"/>
        </Grid.ColumnDefinitions>

        <Button Click="Wyszukiwanie" Content="Powrót do wyszukiwania" HorizontalAlignment="Left" Margin="218,497,0,0" VerticalAlignment="Top" Width="339" Height="33" FontFamily="Verdana" FontSize="22" Background="#FFB0C7C7" Grid.Column="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="209,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="395" Grid.Column="1" FontSize="24" FontFamily="Sitka Small Semibold"><Run Text="Zarejestruj przyj"/><Run Language="pl-pl" Text="ę"/><Run Text="cie towaru"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="86,108,0,0" TextWrapping="Wrap" Text="Kod EAN:" VerticalAlignment="Top" Width="141" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="140" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Text="Nazwa:"/><Run Language="pl-pl" Text=""/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="86,154,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"><Run Language="pl-pl" Text="Kategoria:"/><Run/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="403,153,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="99" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Text="Ilość sztuk:"/><Run Language="pl-pl" Text=""/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="584,153,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Text="Data:"/><Run Language="pl-pl" Text=""/></TextBlock>
        <Button x:Name="przyjmij_guzik" Content="Przyjmij towar" HorizontalAlignment="Left" Margin="14,249,0,0" VerticalAlignment="Top" Height="32" Width="710" FontFamily="Verdana" FontSize="22" Background="#FF93CAA8" BorderBrush="#FF55D044" BorderThickness="0,0,0,0" Click="PrzyjmijGuzikClick" Grid.Column="1"/>
        <TextBox x:Name="eanBox" Grid.Column="1" HorizontalAlignment="Left" Margin="41,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" Height="19"/>
        <TextBox x:Name="nazwaBox" Grid.Column="1" HorizontalAlignment="Left" Margin="503,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252" Height="19"/>
        <DatePicker x:Name="dataBox" Grid.Column="1" HorizontalAlignment="Left" Margin="634,152,0,0" VerticalAlignment="Top" Width="123"/>
        <TextBox x:Name="sztukiBox" Grid.Column="1" HorizontalAlignment="Left" Margin="505,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="19"/>
        <ComboBox x:Name="kategoriaBox" Grid.Column="1" HorizontalAlignment="Left" Margin="41,155,0,0" VerticalAlignment="Top" Width="210" SelectedIndex="0">
            <ComboBoxItem Content="Aparatura"/>
            <ComboBoxItem Content="Kable"/>
            <ComboBoxItem Content="Przewody" />
            <ComboBoxItem Content="Osprzęt"/>
            <ComboBoxItem Content="Narzędzia"/>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="111,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"><Run Language="pl-pl" Text="Sektor:"/><Run/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="144,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Language="pl-pl" Text="Regał:"/><Run/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="424,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Language="pl-pl" Text="Półka:"/><Run/></TextBlock>
        <TextBox x:Name="sektorBox" Grid.Column="1" HorizontalAlignment="Left" Margin="41,205,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="19"/>
        <TextBox x:Name="regalBox" Grid.Column="1" HorizontalAlignment="Left" Margin="209,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="20"/>
        <TextBox x:Name="polkaBox" Grid.Column="1" HorizontalAlignment="Left" Margin="492,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="568,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Language="pl-pl" Text="ID pracownika:"/><Run/></TextBlock>
        <TextBox x:Name="pracownikBox" Grid.Column="1" HorizontalAlignment="Left" Margin="700,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="20"/>
        <TextBlock x:Name="listaBox" HorizontalAlignment="Left" Margin="111,316,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Grid.ColumnSpan="2" Height="151" Width="951" Background="#B2DCDCDC" Foreground="Black" FontFamily="Times New Roman" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="111,292,0,0" TextWrapping="Wrap" Text="Przyjęte towary:" VerticalAlignment="Top" Grid.ColumnSpan="2" FontFamily="Times New Roman" FontSize="16"/>

    </Grid>
</Window>
