<Window x:Class="ElektroBudWPF.WydawanieTowaru"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElektroBudWPF"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        
        Title="Elektro-Bud. Formularz wydawania towaru" Height="600" Width="1000" Background="#FB6E8686" Foreground="White" FontFamily="Verdana">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="181*"/>
        </Grid.ColumnDefinitions>

        <Button Click="Wyszukiwanie" Content="Powrót do wyszukiwania" HorizontalAlignment="Left" Margin="167,486,0,0" VerticalAlignment="Top" Width="339" Height="33" FontFamily="Verdana" FontSize="22" Background="#FFB0C7C7" Grid.Column="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="167,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="395" Grid.Column="1" FontSize="24" FontFamily="Sitka Small Semibold"><Run Text="Zarejestruj wydanie towaru"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="174,108,0,0" TextWrapping="Wrap" Text="Kod EAN produktu:" VerticalAlignment="Top" Width="330" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Margin="177,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="99" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"><Run Text="Ilość sztuk:"/><Run Language="pl-pl" Text=""/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="177,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.ColumnSpan="2"><Run Text="Data:"/><Run Language="pl-pl" Text=""/></TextBlock>
        <Button x:Name="wydaj_guzik" Content="Wydaj towar" HorizontalAlignment="Left" Margin="147,248,0,0" VerticalAlignment="Top" Height="32" Width="710" FontFamily="Verdana" FontSize="22" Background="#FFCA9D93" BorderThickness="0,0,0,0" Click="WydajGuzikClick" Grid.ColumnSpan="2"/>
        <TextBox x:Name="eanBox" TextChanged="eanOrNameBox_TextChanged" Grid.Column="1" HorizontalAlignment="Left" Margin="193,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="365" Height="26"/>
        <DatePicker x:Name="dataBox" Grid.Column="1" HorizontalAlignment="Left" Margin="72,200,0,0" VerticalAlignment="Top" Width="123"/>
        <TextBox x:Name="sztukiBox" Grid.Column="1" HorizontalAlignment="Left" Margin="116,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="24"/>
        <TextBlock HorizontalAlignment="Left" Margin="211,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="232" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Language="pl-pl" Text="ID pracownika:"/><Run/></TextBlock>
        <TextBox x:Name="pracownikBox" Grid.Column="1" HorizontalAlignment="Left" Margin="347,203,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="57" Height="20"/>
        <TextBlock x:Name="listaBox" HorizontalAlignment="Left" Margin="147,315,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Height="151" Width="714" Background="#B2DCDCDC" Foreground="Black" FontFamily="Times New Roman" FontSize="16" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Margin="147,292,0,0" TextWrapping="Wrap" Text="Wydane towary:" VerticalAlignment="Top" FontFamily="Times New Roman" FontSize="16" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="dostepneBox" HorizontalAlignment="Left" Margin="347,150,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Height="24" Width="57" Background="#B2DCDCDC" Foreground="Black" FontFamily="Times New Roman" FontSize="16" Grid.Column="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="215,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="161" FontFamily="Times New Roman" FontSize="20" Grid.Column="1"><Run Text="dostępna ilość:"/><Run Language="pl-pl" Text=""/></TextBlock>

    </Grid>
</Window>
